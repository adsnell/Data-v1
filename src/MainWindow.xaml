<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data v1" Width="1400" Height="800" Background="White"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#202124">
  <Window.Resources>
    <!-- ================= THEME: edit colours here to restyle the whole app ================= -->
    <SolidColorBrush x:Key="cSurface" Color="#EDEFF1"/>
    <SolidColorBrush x:Key="cBorder" Color="#C4C7CC"/>
    <SolidColorBrush x:Key="cText" Color="#202124"/>
    <SolidColorBrush x:Key="cTextDim" Color="#4A4F54"/>
    <SolidColorBrush x:Key="cTextFaint" Color="#80868B"/>
    <SolidColorBrush x:Key="cAccent" Color="#00796B"/>
    <SolidColorBrush x:Key="cAccentDark" Color="#00695C"/>
    <SolidColorBrush x:Key="cAccentTint" Color="#C8E6E2"/>
    <SolidColorBrush x:Key="cAccentTint2" Color="#9DD3CD"/>
    <SolidColorBrush x:Key="cNavy" Color="#17304F"/>
    <SolidColorBrush x:Key="cHover" Color="#E3E6E9"/>

    <!-- selection colours for the folder tree, lists and menus -->
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#C8E6E2"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#202124"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#DCEAE8"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#202124"/>

    <!-- ================= STYLES ================= -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{DynamicResource cBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="SelectionBrush" Value="#80CBC4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
              <Border x:Name="focusLine" Height="2" VerticalAlignment="Bottom" Margin="3,0,3,0" CornerRadius="1"
                      Background="{DynamicResource cAccent}" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="focusLine" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsReadOnly" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource cSurface}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource cSurface}"/>
                <Setter Property="Foreground" Value="{DynamicResource cTextFaint}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Fld" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="6,4"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>

    <Style x:Key="TB" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource cText}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource cAccentTint}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource cAccentTint2}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource cTextFaint}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TBSoft" TargetType="Button" BasedOn="{StaticResource TB}">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{DynamicResource cBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="SaveBtn" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource cAccent}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border Background="{TemplateBinding Background}" CornerRadius="6"/>
              <Border x:Name="hv" Background="White" CornerRadius="6" Opacity="0"/>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hv" Property="Opacity" Value="0.14"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="hv" Property="Opacity" Value="0.26"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Seg" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource cTextDim}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="4" Padding="10,4" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource cHover}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource cAccentTint}"/>
                <Setter Property="Foreground" Value="{DynamicResource cAccentDark}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource cText}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="16" Height="16" CornerRadius="3" BorderThickness="1.5"
                      BorderBrush="{DynamicResource cTextDim}" Background="White" VerticalAlignment="Center">
                <Path x:Name="tick" Data="M3,8 L6.5,11.5 L13,4.5" Stroke="White" StrokeThickness="2"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource cAccent}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="{DynamicResource cAccent}"/>
                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource cAccent}"/>
                <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Lbl" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Foreground" Value="{DynamicResource cTextDim}"/>
      <Setter Property="Margin" Value="0,6,0,1"/>
    </Style>
    <Style x:Key="Head" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource cNavy}"/>
    </Style>
    <Style TargetType="GridViewColumnHeader">
      <Setter Property="Background" Value="{DynamicResource cSurface}"/>
      <Setter Property="Foreground" Value="{DynamicResource cTextDim}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource cBorder}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="8,6"/>
    </Style>
    <Style TargetType="ListViewItem">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="2,3"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
              <GridViewRowPresenter Content="{TemplateBinding Content}"
                                    Columns="{Binding Path=View.Columns, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource cHover}"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource cAccentTint}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource cTextFaint}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

        <!-- ================= ICONS (24 x 24 outline shapes) ================= -->
    <Geometry x:Key="icChevronLeft">M15,5 L8,12 L15,19</Geometry>
    <Geometry x:Key="icChevronRight">M9,5 L16,12 L9,19</Geometry>
    <Geometry x:Key="icFolderPlus">M3,7 A2,2 0 0 1 5,5 H9 L11,7 H19 A2,2 0 0 1 21,9 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 Z M12,10.5 V15.5 M9.5,13 H14.5</Geometry>
    <Geometry x:Key="icFolderDown">M3,7 A2,2 0 0 1 5,5 H9 L11,7 H19 A2,2 0 0 1 21,9 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 Z M12,10 V16 M9.5,13.5 L12,16 L14.5,13.5</Geometry>
    <Geometry x:Key="icFolderShare">M3,7 A2,2 0 0 1 5,5 H9 L11,7 H19 A2,2 0 0 1 21,9 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 Z M8.5,13 H15.5 M13,10.5 L15.5,13 L13,15.5</Geometry>
    <Geometry x:Key="icTrash">M4,7 H20 M9,7 V5 A1,1 0 0 1 10,4 H14 A1,1 0 0 1 15,5 V7 M6,7 L7,19 A2,2 0 0 0 9,21 H15 A2,2 0 0 0 17,19 L18,7 M10,11 V17 M14,11 V17</Geometry>
    <Geometry x:Key="icScissors">M9.1,18 A3.1,3.1 0 1 1 2.9,18 A3.1,3.1 0 1 1 9.1,18 Z M21.1,18 A3.1,3.1 0 1 1 14.9,18 A3.1,3.1 0 1 1 21.1,18 Z M8.2,15.8 L20,4 M15.8,15.8 L4,4</Geometry>
    <Geometry x:Key="icCopy">M11,9 H18 A2,2 0 0 1 20,11 V18 A2,2 0 0 1 18,20 H11 A2,2 0 0 1 9,18 V11 A2,2 0 0 1 11,9 Z M15,9 V6 A2,2 0 0 0 13,4 H6 A2,2 0 0 0 4,6 V13 A2,2 0 0 0 6,15 H9</Geometry>
    <Geometry x:Key="icClipboard">M9,5 H7 A2,2 0 0 0 5,7 V19 A2,2 0 0 0 7,21 H17 A2,2 0 0 0 19,19 V7 A2,2 0 0 0 17,5 H15 M9,5 A1,1 0 0 1 10,4 H14 A1,1 0 0 1 15,5 V6 A1,1 0 0 1 14,7 H10 A1,1 0 0 1 9,6 Z</Geometry>
    <Geometry x:Key="icUndo">M9,14 L4,9 L9,4 M4,9 H14.5 A5.5,5.5 0 0 1 14.5,20 H11</Geometry>
    <Geometry x:Key="icPencil">M5,20 H8 L18.5,9.5 A2.1,2.1 0 0 0 15.5,6.5 L5,17 Z M13.5,8.5 L16.5,11.5</Geometry>
    <Geometry x:Key="icList">M9,6 H20 M9,12 H20 M9,18 H20 M4.5,6 H4.6 M4.5,12 H4.6 M4.5,18 H4.6</Geometry>
    <Geometry x:Key="icGrid">M5,4 H9 A1,1 0 0 1 10,5 V9 A1,1 0 0 1 9,10 H5 A1,1 0 0 1 4,9 V5 A1,1 0 0 1 5,4 Z M15,4 H19 A1,1 0 0 1 20,5 V9 A1,1 0 0 1 19,10 H15 A1,1 0 0 1 14,9 V5 A1,1 0 0 1 15,4 Z M5,14 H9 A1,1 0 0 1 10,15 V19 A1,1 0 0 1 9,20 H5 A1,1 0 0 1 4,19 V15 A1,1 0 0 1 5,14 Z M15,14 H19 A1,1 0 0 1 20,15 V19 A1,1 0 0 1 19,20 H15 A1,1 0 0 1 14,19 V15 A1,1 0 0 1 15,14 Z</Geometry>
    <Geometry x:Key="icSearch">M17,11 A6,6 0 1 1 5,11 A6,6 0 1 1 17,11 Z M15.5,15.5 L20,20</Geometry>
    <Geometry x:Key="icHelp">M21,12 A9,9 0 1 1 3,12 A9,9 0 1 1 21,12 Z M9.5,9.5 A2.5,2.5 0 1 1 12.8,11.8 C12.2,12.2 12,12.6 12,13.5 M12,17 H12.1</Geometry>

    <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource TB}">
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource cTextDim}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6">
              <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                  <Path Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.9"
                        StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
              </Viewbox>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource cAccentTint}"/>
                <Setter Property="Foreground" Value="{DynamicResource cAccentDark}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource cAccentTint2}"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource cTextFaint}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SegIcon" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource cTextDim}"/>
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="bd" CornerRadius="6" Background="Transparent">
              <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                  <Path Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.9"
                        StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Canvas>
              </Viewbox>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource cHover}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource cAccentTint}"/>
                <Setter Property="Foreground" Value="{DynamicResource cAccentDark}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================= LISTS ================= -->
    <GridView x:Key="detailsView" AllowsColumnReorder="False">
      <GridViewColumn Header="Name" Width="300" DisplayMemberBinding="{Binding Name}"/>
      <GridViewColumn Header="Created" Width="130" DisplayMemberBinding="{Binding CreatedText}"/>
      <GridViewColumn Header="Taken" Width="130" DisplayMemberBinding="{Binding TakenText}"/>
      <GridViewColumn Header="Title" Width="200" DisplayMemberBinding="{Binding TitleText}"/>
      <GridViewColumn Header="Subject" Width="160" DisplayMemberBinding="{Binding SubjectText}"/>
      <GridViewColumn Header="Author" Width="140" DisplayMemberBinding="{Binding AuthorText}"/>
      <GridViewColumn Header="Tags" Width="220" DisplayMemberBinding="{Binding TagsText}"/>
      <GridViewColumn Header="Comments" Width="220" DisplayMemberBinding="{Binding CommentText}"/>
      <GridViewColumn Header="Rating" Width="70" DisplayMemberBinding="{Binding RatingText}"/>
      <GridViewColumn Header="Camera" Width="110" DisplayMemberBinding="{Binding CameraText}"/>
      <GridViewColumn Header="Copyright" Width="180" DisplayMemberBinding="{Binding CopyrightText}"/>
      <GridViewColumn Header="Folder" Width="0" DisplayMemberBinding="{Binding FolderText}"/>
    </GridView>
    <ItemsPanelTemplate x:Key="tilePanel"><WrapPanel/></ItemsPanelTemplate>
    <DataTemplate x:Key="tileTemplate">
      <StackPanel Margin="8,6" HorizontalAlignment="Center">
        <Grid Width="100" Height="100">
          <Border CornerRadius="8" Background="{Binding BadgeColor}">
            <TextBlock Text="{Binding Badge}" Foreground="White" FontWeight="Bold" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
        </Grid>
        <TextBlock Text="{Binding Name}" ToolTip="{Binding FullPath}" Width="136" TextAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="0,6,0,0" FontSize="16" TextWrapping="Wrap" MaxHeight="46"/>
      </StackPanel>
    </DataTemplate>
    <Style x:Key="tileStyle" TargetType="ListViewItem">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <Border x:Name="bd" CornerRadius="8" Width="152" Height="178" Margin="1" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#E3E6E9"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#C8E6E2"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="#00796B"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Toolbar and path bar background -->
    <Border Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource cSurface}" BorderBrush="{DynamicResource cBorder}" BorderThickness="0,0,0,1"/>

    <!-- Toolbar -->
    <DockPanel Grid.Row="0" Margin="8,6,8,4" LastChildFill="False">
      <Button x:Name="btnBack" Style="{StaticResource IconBtn}" Tag="{StaticResource icChevronLeft}" ToolTip="Back (Alt+Left)"/>
      <Button x:Name="btnFwd" Style="{StaticResource IconBtn}" Tag="{StaticResource icChevronRight}" ToolTip="Forward (Alt+Right)"/>
      <Border Width="1" Height="22" Background="{DynamicResource cBorder}" Margin="8,0"/>
      <Button x:Name="btnNew" Style="{StaticResource IconBtn}" Tag="{StaticResource icFolderPlus}" ToolTip="New folder"/>
      <Button x:Name="btnDelete" Style="{StaticResource IconBtn}" Tag="{StaticResource icTrash}" ToolTip="Delete (Del)"/>
      <Border Width="1" Height="22" Background="{DynamicResource cBorder}" Margin="8,0"/>
      <Button x:Name="btnCut" Style="{StaticResource IconBtn}" Tag="{StaticResource icScissors}" ToolTip="Cut (Ctrl+X)"/>
      <Button x:Name="btnCopy" Style="{StaticResource IconBtn}" Tag="{StaticResource icCopy}" ToolTip="Copy (Ctrl+C)"/>
      <Button x:Name="btnPaste" Style="{StaticResource IconBtn}" Tag="{StaticResource icClipboard}" ToolTip="Paste (Ctrl+V)"/>
      <Border Width="1" Height="22" Background="{DynamicResource cBorder}" Margin="8,0"/>
      <Button x:Name="btnCopyTo" Style="{StaticResource IconBtn}" Tag="{StaticResource icFolderDown}" ToolTip="Copy to a folder..."/>
      <Button x:Name="btnMoveTo" Style="{StaticResource IconBtn}" Tag="{StaticResource icFolderShare}" ToolTip="Move to a folder..."/>
      <Border Width="1" Height="22" Background="{DynamicResource cBorder}" Margin="8,0"/>
      <RadioButton x:Name="rbDetails" GroupName="v" Style="{StaticResource SegIcon}" Tag="{StaticResource icList}" ToolTip="Details view" VerticalAlignment="Center" Margin="4,0,0,0"/>
      <RadioButton x:Name="rbThumbs" GroupName="v" Style="{StaticResource SegIcon}" Tag="{StaticResource icGrid}" ToolTip="Thumbnails view" IsChecked="True" VerticalAlignment="Center" Margin="2,0,0,0"/>
      <Button x:Name="btnHelp" Style="{StaticResource IconBtn}" Tag="{StaticResource icHelp}" ToolTip="Help (F1)" DockPanel.Dock="Right" Margin="8,0,0,0"/>
      <TextBox x:Name="txtSearch" DockPanel.Dock="Right" Width="180" Height="26" VerticalContentAlignment="Center"/>
      <Viewbox DockPanel.Dock="Right" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Data="{StaticResource icSearch}" Stroke="{DynamicResource cTextDim}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
    </DockPanel>

    <!-- Path bar -->
    <DockPanel Grid.Row="1" Margin="8,2,8,6">
      <TextBlock Text="Path:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource cTextDim}" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <TextBox x:Name="txtPath" IsReadOnly="True" Height="26" VerticalContentAlignment="Center" FontSize="12"/>
    </DockPanel>

    <!-- Main area -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="230"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="280"/>
      </Grid.ColumnDefinitions>

      <!-- Left: tree -->
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Folders" Style="{StaticResource Head}" Margin="8,6,0,5"/>
        <TreeView x:Name="tree" BorderBrush="{DynamicResource cBorder}" BorderThickness="0,1,1,0" FontSize="14"/>
      </DockPanel>
      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="Transparent"/>

      <!-- Centre: files -->
      <ListView x:Name="list" Grid.Column="2" SelectionMode="Extended" BorderBrush="{DynamicResource cBorder}" BorderThickness="0,1,0,0"/>
      <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="Transparent"/>

      <!-- Right: metadata -->
      <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" Background="{DynamicResource cSurface}">
        <StackPanel Margin="12,0,12,12">
          <TextBlock Text="Details" Style="{StaticResource Head}" Margin="0,6,0,0"/>
          <TextBlock Text="File name:" Style="{StaticResource Lbl}"/>
          <TextBox x:Name="txtName" Style="{StaticResource Fld}"/>
          <TextBlock Text="Title:" Style="{StaticResource Lbl}"/>
          <TextBox x:Name="txtTitle" Style="{StaticResource Fld}"/>
          <TextBlock Text="Subject:" Style="{StaticResource Lbl}"/>
          <TextBox x:Name="txtSubject" Style="{StaticResource Fld}"/>
          <TextBlock Text="Authors:" Style="{StaticResource Lbl}"/>
          <TextBox x:Name="txtAuthors" Style="{StaticResource Fld}"/>
          <TextBlock Text="Tags:" Style="{StaticResource Lbl}"/>
          <TextBox x:Name="txtTags" Style="{StaticResource Fld}"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button x:Name="btnTagAdd" Content="+ Add tags" Style="{StaticResource TBSoft}" Margin="0,0,6,0"/>
            <Button x:Name="btnTagRemove" Content="&#x2013; Remove tags" Style="{StaticResource TBSoft}"/>
          </StackPanel>
          <TextBlock Text="Comments:" Style="{StaticResource Lbl}"/>
          <TextBox x:Name="txtComments" Style="{StaticResource Fld}" Height="60" VerticalContentAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
          <TextBlock Text="Copyright:" Style="{StaticResource Lbl}"/>
          <TextBox x:Name="txtCopyright" Style="{StaticResource Fld}"/>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <Button x:Name="btnCrUse" Content="Insert preset" Style="{StaticResource TBSoft}" Margin="0,0,6,0"/>
            <Button x:Name="btnCrSet" Content="Set preset..." Style="{StaticResource TBSoft}"/>
          </StackPanel>
          <TextBlock Text="Rating (1-5):" Style="{StaticResource Lbl}"/>
          <TextBox x:Name="txtRating" Style="{StaticResource Fld}"/>
          <Button x:Name="btnSave" Content="SAVE METADATA" Style="{StaticResource SaveBtn}" Height="38" Margin="0,16,0,0" FontSize="14"/>
          <Border Background="White" BorderBrush="{DynamicResource cBorder}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="File info" Style="{StaticResource Head}" FontSize="11"/>
              <TextBlock x:Name="sysInfo" FontSize="11" Foreground="{DynamicResource cTextDim}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="3" Background="{DynamicResource cSurface}" BorderBrush="{DynamicResource cBorder}" BorderThickness="0,1,0,0" Padding="8,5">
      <TextBlock x:Name="txtStatus" FontSize="14"/>
    </Border>
  </Grid>
</Window>